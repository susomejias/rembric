{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/session-start.sh codex-cli"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "remember|recall|acordate|qué hicimos|what did we do",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/prompt-search.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/session-stop.sh codex-cli"
          }
        ]
      }
    ]
  }
}
