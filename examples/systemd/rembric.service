[Unit]
Description=rembric (MCP memory server for AI agents)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rembric
Group=rembric
WorkingDirectory=/var/lib/rembric
EnvironmentFile=/etc/rembric/rembric.env
# Install once on the host: `pnpm add -g rembric` (or `npm i -g rembric`).
# That puts the `rembric` binary on $PATH so this unit launches cleanly.
ExecStart=/usr/bin/env rembric
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rembric

[Install]
WantedBy=multi-user.target
