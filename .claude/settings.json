{
  "permissions": {
    "allow": ["mcp__codegraph__*"]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v codegraph >/dev/null 2>&1; then codegraph prompt-hook; fi"
          }
        ]
      }
    ]
  }
}
