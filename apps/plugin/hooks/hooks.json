{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "REMBRIC_SERVER_URL='${user_config.server_url}' REMBRIC_API_TOKEN='${user_config.api_token}' \"${CLAUDE_PLUGIN_ROOT}\"/scripts/session-start.sh claude-code"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "REMBRIC_SERVER_URL='${user_config.server_url}' REMBRIC_API_TOKEN='${user_config.api_token}' \"${CLAUDE_PLUGIN_ROOT}\"/scripts/post-compact.sh claude-code"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "remember|recall|acordate|qué hicimos|what did we do",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/prompt-search.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "REMBRIC_SERVER_URL='${user_config.server_url}' REMBRIC_API_TOKEN='${user_config.api_token}' \"${CLAUDE_PLUGIN_ROOT}\"/scripts/session-end.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "REMBRIC_SERVER_URL='${user_config.server_url}' REMBRIC_API_TOKEN='${user_config.api_token}' \"${CLAUDE_PLUGIN_ROOT}\"/scripts/pre-compact.sh claude-code"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "REMBRIC_SERVER_URL='${user_config.server_url}' REMBRIC_API_TOKEN='${user_config.api_token}' \"${CLAUDE_PLUGIN_ROOT}\"/scripts/post-compaction.sh"
          }
        ]
      }
    ]
  }
}
