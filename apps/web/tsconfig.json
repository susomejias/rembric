{
  "extends": "@rembric/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"],
      "@rembric/db": ["../../packages/db/src/index.ts"],
      "@rembric/core": ["../../packages/core/src/index.ts"],
      "@rembric/mcp": ["../../packages/mcp/src/index.ts"]
    },
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "postcss.config.mjs",
    "next.config.mjs"
  ],
  "exclude": ["node_modules"]
}
