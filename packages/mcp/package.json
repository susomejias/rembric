{
  "name": "@rembric/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Rembric MCP protocol layer — tool definitions, the McpServer factory, scope resolution and instructions. Depends on @rembric/core; no SQL, no HTTP.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@rembric/core": "workspace:*",
    "@rembric/db": "workspace:*",
    "slugify": "^1.6.9",
    "stopword": "^3.1.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@rembric/config": "workspace:*",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
