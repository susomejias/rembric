# Rembric server configuration.
#
# Copy this file to `.env`, fill in the required values, and run:
#     docker compose up -d
#
# `.env` is gitignored; never commit your secrets.

# ── Required ────────────────────────────────────────────────────────
# Generate once and keep it secret:  openssl rand -hex 32
REMBRIC_ADMIN_TOKEN=

# ── LLM provider (OpenAI-compatible: OpenAI / Ollama / LM Studio / vLLM) ──
# For Ollama on the SAME host as Docker, use host.docker.internal:
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2.5:7b
OPENAI_EMBEDDING_MODEL=nomic-embed-text

# ── Image version pin ──────────────────────────────────────────────
# Default unset = `:latest`. Pin to a specific tag for reproducible
# deploys (recommended once a version proves stable in your setup):
# REMBRIC_VERSION=0.13.0

# ── Common toggles (uncomment to override defaults) ────────────────
# REMBRIC_PORT=8787
# LOG_LEVEL=info
# EMBEDDING_ENABLED=true
# CONSOLIDATION_ENABLED=true

# ── Advanced knobs (uncomment to override defaults) ────────────────
# Rate limiting (off by default; enable for multi-agent deployments):
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_RPS=10
# RATE_LIMIT_BURST=30

# Sessions sweep: how old an 'active' session can be at startup before
# it's flipped to 'abandoned'. Default 24h. Floor 60s, ceiling 30 days:
# SESSION_ABANDON_AFTER_MS=86400000

# Consolidation tuning:
# CONSOLIDATION_CRON=0 3 * * *
# CONSOLIDATION_BATCH_SIZE=50

# Save-time candidate detection (fresh-context judgment):
# CANDIDATES_PER_SAVE_MAX=5
# CANDIDATE_VEC_THRESHOLD=0.85
# CANDIDATE_FTS_THRESHOLD=0.4

# Orphan promotion: pending judgments older than this go to the LLM
# judge during consolidation. Default 24h:
# JUDGMENT_ORPHAN_AFTER_MS=86400000

# Full reference: README.md#configuration  +  src/config.ts
