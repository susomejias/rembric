{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "packages": {
    "apps/server": {
      "release-type": "node",
      "component": "server",
      "package-name": "@rembric/server",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "draft": false,
      "prerelease": false,
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "refactor", "section": "Refactor" },
        { "type": "docs", "section": "Documentation" },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Build", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "chore", "section": "Chore", "hidden": true },
        { "type": "style", "section": "Style", "hidden": true },
        { "type": "revert", "section": "Reverts" }
      ]
    },
    "apps/plugin": {
      "release-type": "node",
      "component": "plugin",
      "package-name": "@rembric/plugin",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "extra-files": [
        ".claude-plugin/package.json",
        ".claude-plugin/plugin.json",
        ".codex-plugin/package.json",
        ".codex-plugin/plugin.json",
        ".hermes-plugin/plugin.yaml",
        { "type": "generic", "path": ".opencode-plugin/plugin.ts" },
        ".pi-plugin/package.json",
        "mcp-bridge/package.json",
        {
          "type": "json",
          "path": ".claude-plugin/mcp.json",
          "jsonpath": "$.mcpServers.rembric.args[1]"
        },
        {
          "type": "json",
          "path": ".codex-plugin/mcp.json",
          "jsonpath": "$.mcpServers.rembric.args[1]"
        }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "refactor", "section": "Refactor" },
        { "type": "docs", "section": "Documentation" },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Build", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "chore", "section": "Chore", "hidden": true },
        { "type": "style", "section": "Style", "hidden": true },
        { "type": "revert", "section": "Reverts" }
      ]
    }
  }
}
