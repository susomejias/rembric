# Disable all dependency lifecycle scripts by default.
# Exceptions are declared in pnpm-workspace.yaml::onlyBuiltDependencies.
# See .agents/skills/npm-security-best-practices/SKILL.md for the rationale.
ignore-scripts=true

# Fail-fast on Node <22.13 (pnpm 11 imports node:sqlite); see openspec/specs/supply-chain-hygiene/spec.md.
engine-strict=true
